# Leave unset to use the built-in MSW mock API and the in-browser scripted
# opponent (the default, and what the deployed demo uses). Point it at a real
# Bunny Code API v2 to opt out — for the local stack:
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v2

# The STOMP WebSocket endpoint. Defaults to `<NEXT_PUBLIC_API_URL>/ws` (with
# ws:// or wss://), so it only needs setting when the socket is served elsewhere.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/api/v2/ws
