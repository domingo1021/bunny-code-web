# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS
.DS_Store
Thumbs.db
*.pem

# editors / IDEs
.idea/
.vscode/
*.swp

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example is committed on purpose)
.env*
!.env.example

# vercel
.vercel

# The backend repository, which the integration CI job checks out in here.
/backend/

# claude code (shared settings are committed, local overrides are not)
.claude/settings.local.json
